{
  "manifest_version": 3,
  "name": "IG Auto",
  "version": "1.0.0",
  "description": "Bulk-follow followers/likers, track follows per account, and auto-unfollow on follow-back.",
  "permissions": ["storage", "alarms", "cookies", "scripting", "tabs", "sidePanel"],
  "host_permissions": ["*://*.instagram.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["storage.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "IG Auto",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
